{
  "name": "molecular-vibration-visualizer",
  "version": "1.0.0",
  "description": "Chemical molecular vibration visualization web application",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
